# ─── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Google Sheets ──────────────────────────────────────────
GOOGLE_SA_JSON=secrets/google-sa.json
SPREADSHEET_ID=
QUEUE_TAB=queue
CLIPS_TAB=clips

# ─── Instagram Graph API ────────────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=

# ─── LinkedIn ───────────────────────────────────────────────
LI_ACCESS_TOKEN=
LI_AUTHOR_URN=urn:li:person:XXXX

# ─── Storage público (Cloudflare R2 / S3) ───────────────────
R2_ACCOUNT_ID=
R2_BUCKET=reelforge
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE=https://cdn.example.com

# ─── Pipeline ───────────────────────────────────────────────
CLIPS_PER_VIDEO_DEFAULT=5
CLIP_MIN_SECONDS=35
CLIP_MAX_SECONDS=60
SOURCE_MAX_MINUTES=20
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WORKER_POLL_SECONDS=60

# ─── Branding ───────────────────────────────────────────────
BRAND_WATERMARK=@tu_handle
BRAND_FONT=assets/fonts/Inter-Bold.ttf
BRAND_COLOR_PRIMARY=#FFDD2D
BRAND_COLOR_TEXT=#FFFFFF
