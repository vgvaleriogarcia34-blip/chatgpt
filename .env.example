# Microsoft Azure App Registration
# Crea una app en https://portal.azure.com -> Azure Active Directory -> App registrations
# Redirect URI: http://localhost:8000/auth/callback (tipo Web)
# Permisos delegados Microsoft Graph: Mail.Read, Mail.Send, offline_access, User.Read
MS_CLIENT_ID=tu-client-id-aqui
MS_CLIENT_SECRET=tu-client-secret-aqui
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:8000/auth/callback

# Anthropic Claude
# Obten tu key en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Secret para firmar la sesion (cambialo)
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio
