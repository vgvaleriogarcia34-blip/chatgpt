# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# LinkedIn (https://www.linkedin.com/developers/apps)
# Crea una app, solicita los scopes: w_member_social, r_liteprofile, r_emailaddress
# y obtén un access token OAuth2 de 3 piernas.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX

# Opcional: ruta del store de leads
LEADS_DB_PATH=./leads.sqlite3
